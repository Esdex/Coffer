<?xml version="1.0" encoding="utf-8"?>
<!--
  Inflated rather than built in code for one attribute with no setter: surface_type. A SurfaceView,
  the default, is composited outside the view tree, so a Compose zoom would move an empty frame; a
  TextureView follows it (as Arcanum found).
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:use_controller="false"
    app:resize_mode="fit" />
