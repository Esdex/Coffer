<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Transfers run as a foreground service with a progress notification (SPEC §6). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Music plays on in the background with its controls in a notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Edit in another app offers editors first: without this, Android 11 and later find none for
         ACTION_EDIT, and every viewer got write access (audit 3, AND3-9). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.EDIT" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <application>
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- Exported for the system's media controls and headset buttons; AudioService admits only
             Coffer and the system. -->
        <service
            android:name="me.esdex.coffer.feature.browser.viewer.audio.AudioService"
            tools:ignore="ExportedService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- Decrypted copies for "open in another app" (SPEC §6), only from cache/open. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/open_files" />
        </provider>

        <!-- Copies decrypted for editing in another app, read and write, from no_backup/edit (2026-11-19). -->
        <provider
            android:name=".transfer.EditProvider"
            android:authorities="${applicationId}.edit"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- Coffer in the system file picker (2026-11-20): off until the setting turns it on, and then only
             the system's picker lists it; an app gets the files picked there. -->
        <provider
            android:name=".transfer.VaultDocumentsProvider"
            android:authorities="${applicationId}.documents"
            android:enabled="false"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>

</manifest>
